<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Upgraded from .NET Framework 4.6.1 (EOL) to .NET 8 LTS for cloud/Linux compatibility -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LandTitleRegistration</RootNamespace>
    <AssemblyName>LandTitleRegistration</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core Web API — replaces System.Web / IIS dependencies (cr-dotnet-0044) -->
    <!-- Provides ILogger, IConfiguration, IHttpClientFactory, middleware pipeline -->

    <!-- Azure App Configuration — externalises URLs, paths, ports (cr-dotnet-0011, cr-dotnet-0017, cr-dotnet-0001) -->
    <PackageReference Include="Microsoft.Azure.AppConfiguration.AspNetCore" Version="8.0.0" />

    <!-- Azure Key Vault secrets provider — replaces hard-coded credentials (cr-dotnet-0009, cr-dotnet-0123) -->
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />
    <PackageReference Include="Azure.Identity" Version="1.12.0" />

    <!-- Azure Cache for Redis — replaces static collections and InProc session state
         (cr-dotnet-0006, cr-dotnet-0045, cr-dotnet-0126) -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.0.0" />

    <!-- Azure Monitor Application Insights — replaces log4net file appenders (cr-dotnet-0035) -->
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />

    <!-- Microsoft.Data.SqlClient — modern, cross-platform SQL client (replaces System.Data.SqlClient) -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.1" />

    <!-- Newtonsoft.Json upgraded to patched version (CVE-2024-21907 remediation) -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- System.Text.Encodings.Web upgraded to patched version (CVE-2021-26701 remediation) -->
    <PackageReference Include="System.Text.Encodings.Web" Version="8.0.0" />

    <!-- NuGet.Frameworks removed (CVE-2023-29337) — not required at runtime -->
    <!-- log4net removed — replaced by ILogger + Application Insights (cr-dotnet-0035) -->
    <!-- Microsoft.Win32.Registry removed — replaced by Azure App Configuration (cr-dotnet-0040) -->
    <!-- System.Web removed — replaced by ASP.NET Core middleware (cr-dotnet-0044) -->
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Controllers\TitleController.cs" />
    <Compile Include="Services\TitleService.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

</Project>
